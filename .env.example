# Copy this file to .env and fill in real values before running in production.

# Long random string used to sign session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Path to the SQLite database file. Leave commented out to use the default
# (instance/licensure.db under the project directory, resolved to an
# absolute path automatically). Only set this if you need the database
# somewhere else — use an absolute sqlite:////full/path/to/file.db so it
# doesn't depend on the working directory the app is started from.
# DATABASE_URL=sqlite:////full/path/to/instance/licensure.db

# Credentials for the initial admin account created by `flask seed-admin`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=you@example.com

# Warning thresholds, in days before expiration, used to color-code the dashboard.
WARNING_DAYS=90
CRITICAL_DAYS=30
